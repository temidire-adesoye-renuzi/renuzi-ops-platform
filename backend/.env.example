# ============================================================
# RENUZI OPERATIONS PLATFORM - ENVIRONMENT TEMPLATE (HARDENED)
# Copy this file to .env and fill in real values.
#   PowerShell: Copy-Item .env.example .env
# NEVER commit the real .env to git.
#
# SECURITY RULES:
# - The app REFUSES TO START in production if any secret below
#   still contains a placeholder or a known-default value
#   (see src/config/env.js fail-fast validation).
# - Use a dedicated least-privilege SQL login (database/03), never 'sa'.
# ============================================================

# --- Server ---
PORT=3000
# development | test | production
NODE_ENV=development

# --- Feature flags ---
# Master gate for ALL cron jobs below (queue, GRN close, sweep, retention)
SYNC_CRON_ENABLED=true
# Cron schedule for queue processing (default: every minute)
SYNC_CRON_SCHEDULE=*/1 * * * *
# GRN auto-close/escalation job schedule (default: hourly)
GRN_CLOSE_CRON_SCHEDULE=0 * * * *

# --- Change-log maintenance (sweep + retention; need SYNC_CRON_ENABLED=true) ---
# Reconciliation sweeper: re-emit writes that bypassed the outbox and
# tombstone hard deletes (default: every 5 minutes)
SWEEP_CRON_ENABLED=true
SWEEP_CRON_SCHEDULE=*/5 * * * *
# Retention purge of sync_change_log rows via sp_sync_change_log_retention
# (default: daily at 03:15, low-traffic window)
RETENTION_CRON_ENABLED=true
RETENTION_CRON_SCHEDULE=15 3 * * *
# Days a change-log row survives the purge. Unset/empty defers to the
# app_config key of the same name seeded by database/05 (proc default 30).
#SYNC_CHANGE_LOG_RETENTION_DAYS=30

# --- SQL Server 2022 ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=RenuziOpsDB
# LEAST PRIVILEGE: use the app login created by database/03_least_privilege.sql
DB_USER=renuzi_app
DB_PASSWORD=change-me-to-a-strong-password
# Set true only for Azure SQL or when the server enforces TLS
DB_ENCRYPT=false
DB_POOL_MAX=20
DB_POOL_MIN=2

# --- Auth / JWT ---
# Generate a strong secret, e.g. PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# --- Upload service ---
# local | azure-blob (blob support requires AZURE_STORAGE_CONNECTION_STRING)
UPLOAD_STORAGE_DRIVER=local
UPLOAD_LOCAL_DIR=./uploads
# Max upload size in bytes (default 10 MB)
UPLOAD_MAX_BYTES=10485760
# Comma-separated whitelist of allowed MIME types
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
# ClamAV virus scanning endpoint (clamd TCP socket). Empty disables scanning.
VIRUS_SCAN_HOST=
VIRUS_SCAN_PORT=3310
# Expiry for generated signed URLs, in seconds
UPLOAD_SIGNED_URL_TTL=900

# --- Azure Blob (only when UPLOAD_STORAGE_DRIVER=azure-blob) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=renuzi-uploads

# --- Sync hardening ---
# Minutes a PROCESSING row may be stuck before it is reclaimed by the scheduler
SYNC_STUCK_PROCESSING_MINUTES=10
# Retry backoff base seconds: delay = base * 2^retryCount (jittered)
SYNC_BACKOFF_BASE_SECONDS=30
# Reset a FAILED row to PENDING so it resumes retrying (used by tests/admin)
SYNC_RETRY_MAX_DEFAULT=5
